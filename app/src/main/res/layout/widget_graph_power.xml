<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_graph_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101926"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_graph_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="POWER HISTORY"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_graph_live_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14.8 W"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_graph_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raw Incoming Power"
        android:textColor="#90A4AE"
        android:textSize="8.5sp" />

    <ImageView
        android:id="@+id/widget_graph_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:contentDescription="Power History Graph" />
</LinearLayout>
